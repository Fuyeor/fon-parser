{
  "name": "@fuyeor/fon-parser",
  "version": "0.1.0",
  "description": "A dependency-free native TypeScript parser for Fer Object Notation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.7.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' README.md package.json pnpm-lock.yaml tsconfig.json .prettierrc.json",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' README.md package.json pnpm-lock.yaml tsconfig.json .prettierrc.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
